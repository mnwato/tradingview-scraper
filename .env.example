
# --- Option 1: Cookie-based Authentication ---
# Step 1: Open https://www.tradingview.com/chart/ in your browser
# Step 2: Log in to your TradingView account
# Step 3: Open Developer Tools (F12) and go to Network tab
# Step 4: Refresh the page and find any request to data.tradingview.com
# Step 5: Copy the cookie value from the request headers
# Step 6: Paste it below (no escaping needed)
TRADINGVIEW_COOKIE = "your_cookie_here"

# Step 7: Copy the URL of any open TradingView chart(make sure you are logged in)
# Example: https://www.tradingview.com/chart/ABC123/
# Paste it below
TRADINGVIEW_CHART_URL = "your_chart_url_here"

# --- Option 2: Manual JWT Token (Alternative) ---
# If you prefer to use a manual JWT token instead of cookies:
# TRADINGVIEW_JWT_TOKEN = "your_jwt_token_here"